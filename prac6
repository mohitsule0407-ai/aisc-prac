AIM: Creating/building a neural network using basic language using C Programming

#include<stdio.h>

int main()
{
// AND gate input
int input[4][2] = {
{0, 0},
{0, 1},
{1, 0},
{1, 1}
};

// Expected output
int target[4] = {0, 0, 0, 1};

// Initial weights and bias
float w1 = 0.0;
float w2 = 0.0;
float bias = 0.0;

float learning_rate = 0.1;

int epochs = 10;

// Training
for (int epoch = 0; epoch &lt; epochs; epoch++)
{
printf(&quot;Epoch %d\n&quot;, epoch + 1);

for (int i = 0; i &lt; 4; i++)
{
// Calculate weighted sum
float sum = (input[i][0] * w1) +
(input[i][1] * w2) +
bias;

// Activation function
int output;

if (sum &gt;= 1.0)
output = 1;
else
output = 0;

// Calculate error
int error = target[i] - output;

// Update weights and bias
w1 = w1 + learning_rate * error * input[i][0];

w2 = w2 + learning_rate * error * input[i][1];
bias = bias + learning_rate * error;

printf(&quot;Input: %d %d | Target: %d | Output: %d | Error: %d\n&quot;,
input[i][0],
input[i][1],
target[i],
output,
error);
printf(&quot;\n&quot;);
}
printf(&quot;w1 = %.2f\n&quot;, w1);
printf(&quot;w2 = %.2f\n&quot;, w2);
printf(&quot;bias = %.2f\n&quot;, bias);

}

// Testing
printf(&quot;Final AND Gate Results:\n&quot;);

for (int i = 0; i &lt; 4; i++)
{
float sum = (input[i][0] * w1) +
(input[i][1] * w2) +
bias;

int output;

if (sum &gt;= 1.0)
output = 1;
else
output = 0;

printf(&quot;%d AND %d = %d\n&quot;,
input[i][0],
input[i][1],
output);
}

printf(&quot;\nFinal weights:\n&quot;);
printf(&quot;w1 = %.2f\n&quot;, w1);
printf(&quot;w2 = %.2f\n&quot;, w2);
printf(&quot;bias = %.2f\n&quot;, bias);

return 0;
}
