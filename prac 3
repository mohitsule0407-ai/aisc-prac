Depth-First Search (DFS):-

def dfs(graph, start, goal):
    stack = [[start]] # Stack stores paths
    visited = set()
   
    while stack:
        path = stack.pop() # Pop the last path (LIFO)
        node = path[-1]
       
        if node == goal:
            return path
       
        if node not in visited:
            visited.add(node) # Explore neighbors in reverse order to
simulate standard DFS behavior
            # (or process in forward order if you want the first neighbor
to be explored last from the stack)
            for neighbor in reversed(graph.get(node, [])):
                if neighbor not in visited:
                    stack.append(path + [neighbor])
    return None
   
graph = {
          &#39;A&#39;: [&#39;B&#39;, &#39;C&#39;],
          &#39;B&#39;: [&#39;D&#39;, &#39;E&#39;],
          &#39;C&#39;: [&#39;F&#39;],
          &#39;D&#39;: [],
